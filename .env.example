# Recess Local Development Environment Variables

# Server Configuration
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# PostgreSQL Configuration
POSTGRES_USER=recess
POSTGRES_PASSWORD=recess_secret
POSTGRES_DB=recess_db
POSTGRES_PORT=5432
DATABASE_URL=postgres://recess:recess_secret@postgres:5432/recess_db?sslmode=disable

# Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
